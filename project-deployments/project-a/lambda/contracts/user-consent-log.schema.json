{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sar-sandbox.local/contracts/user-consent-log.schema.json",
  "title": "User Consent Log",
  "description": "Payload for a User Consent Log SAR document request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["consent_types", "include_withdrawals"],
  "properties": {
    "consent_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Marketing Email",
          "Marketing SMS",
          "Analytics",
          "Third Party Sharing",
          "Profiling",
          "Cookies Essential",
          "Cookies Optional"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "include_withdrawals": {
      "type": "boolean",
      "description": "Include consent withdrawal events"
    },
    "date_from": {
      "type": "string",
      "format": "date"
    },
    "date_to": {
      "type": "string",
      "format": "date"
    },
    "include_policy_versions": {
      "type": "boolean",
      "default": true,
      "description": "Include the privacy policy version in force at each consent event"
    }
  }
}
